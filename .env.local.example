# =============================================================================
#  AI-Think-Thank — VERSION LOCALE (NVIDIA NIM + émulateur Firebase)
#  Copiez ce fichier en .env.local puis renseignez vos valeurs.
#    cp .env.local.example .env.local
#  ⚠️ .env.local est ignoré par git (voir .gitignore) — ne committez jamais
#     votre clé API.
# =============================================================================

# --- NVIDIA NIM (endpoints gratuits) -----------------------------------------
# Obtenez une clé "nvapi-..." sur https://build.nvidia.com (1000 crédits offerts).
NVIDIA_API_KEY=nvapi-REMPLACEZ_MOI

# Endpoint OpenAI-compatible de NVIDIA (laisser tel quel sauf instruction contraire).
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Modèle par défaut. DOIT supporter tool_calling + structured output (JSON).
# Exemples valides (vérifier la dispo "Free Endpoint" sur build.nvidia.com/models) :
#   meta/llama-3.3-70b-instruct
#   nvidia/llama-3.1-nemotron-70b-instruct
#   qwen/qwen2.5-coder-32b-instruct
#   mistralai/mistral-large-2-instruct
NVIDIA_DEFAULT_MODEL=meta/llama-3.3-70b-instruct

# Exposé au client pour pré-sélectionner le modèle par défaut dans l'UI (optionnel).
NEXT_PUBLIC_NVIDIA_DEFAULT_MODEL=meta/llama-3.3-70b-instruct

# --- Firebase : émulateur local ----------------------------------------------
# Mettez "true" pour utiliser l'émulateur Firestore local (100% hors-ligne).
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080

# Optionnel : surcharge de la config Firebase (sinon valeurs par défaut du repo).
# Avec l'émulateur, n'importe quel projectId factice convient.
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-app
# NEXT_PUBLIC_FIREBASE_API_KEY=demo
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-app.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-app.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
# NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
